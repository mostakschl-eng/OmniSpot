import { Palette } from "std-widgets.slint";

export global OmniTheme {
    in property <int> requested-theme;
    changed requested-theme => {
        Palette.color-scheme = requested-theme == 1 ? ColorScheme.dark
            : requested-theme == 2 ? ColorScheme.light : ColorScheme.unknown;
    }
    private property <color> fluent-background: Palette.background;
    out property <bool> dark: requested-theme == 1 || (requested-theme == 0 && fluent-background == #1c1c1c);
    out property <color> window-background: dark ? #202020 : #fafafa;
    out property <color> navigation-background: dark ? #1c1c1c : #f3f3f3;
    out property <color> page-background: dark ? #202020 : #fdfdfd;
    out property <color> text-primary: dark ? #ffffff : #000000e4;
    out property <color> text-secondary: dark ? #ffffffc5 : #0000009e;
    out property <color> card-background: dark ? #ffffff0d : #ffffffb3;
    out property <color> card-border: dark ? #00000019 : #0000000f;
    out property <color> accent: Palette.accent-background;
    out property <color> accent-text: dark ? #000000 : #ffffff;
    out property <color> text-tertiary: dark ? #ffffff8b : #00000072;
    out property <color> popup-background: dark ? #1c1c1cf5 : #eeeeeef5;
    out property <color> divider: dark ? #ffffff15 : #00000014;
    out property <color> subtle: dark ? #ffffff0f : #00000009;
    out property <color> caution: dark ? #fce100 : #9d5d00;
}

export component TextLink inherits FocusScope {
    in property <string> label;
    callback activated();
    preferred-width: caption.preferred-width;
    preferred-height: caption.preferred-height;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.activated(); }
    caption := Text {
        text: root.label;
        color: OmniTheme.accent;
        font-size: 12px;
        vertical-alignment: center;
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.focus(); root.activated(); } }
    key-pressed(event) => {
        if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
        reject
    }
}

export component Symbol inherits Text {
    font-family: "Segoe MDL2 Assets";
    font-size: 18px;
    color: OmniTheme.text-primary;
    horizontal-alignment: center;
    vertical-alignment: center;
}

export component PopupCard inherits Rectangle {
    background: OmniTheme.popup-background;
    border-color: OmniTheme.divider;
    border-width: 1px;
    border-radius: 12px;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: OmniTheme.dark ? #00000073 : #00000059;
}

export component KeyBadge inherits Rectangle {
    in property <string> label;
    in property <length> label-size: 13px;
    border-radius: 4px;
    border-width: 1px;
    border-color: OmniTheme.divider;
    background: OmniTheme.subtle;
    Text {
        text: root.label;
        color: OmniTheme.text-primary;
        font-size: root.label-size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component SettingsCard inherits Rectangle {
    background: OmniTheme.card-background;
    border-color: OmniTheme.card-border;
    border-width: 1px;
    border-radius: 4px;
    @children
}
