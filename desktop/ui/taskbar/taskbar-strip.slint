import { ScrollView } from "std-widgets.slint";
import { OmniTheme } from "../theme.slint";
import { AppDock, DockApp } from "app-dock.slint";

export component TaskbarStrip inherits Rectangle {
    in property <[DockApp]> apps;
    in property <bool> center-apps: true;
    out property <string> hovered-app: dock.hovered-app;
    callback app-selected(string);

    height: OmniTheme.strip-height + (dock.preferred-width + 16px > self.width ? 14px : 0px);
    Rectangle { height: 1px; background: OmniTheme.glass-border-subtle; }

    ScrollView {
        width: parent.width; height: parent.height;
        content-width: max(self.width, dock.preferred-width + 16px);
        content-height: self.height;
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;
        dock := AppDock {
            apps: root.apps;
            width: self.preferred-width;
            y: (OmniTheme.strip-height - self.height) / 2;
            x: root.center-apps ? max(8px, (root.width - self.width) / 2) : 8px;
            app-selected(id) => { root.app-selected(id); }
        }
    }
}
