import { TaskbarWindow } from "taskbar-window.slint";
import { TaskbarResult } from "search-results.slint";
import { DockApp } from "app-dock.slint";
import { CalendarMonth } from "calendar.slint";

export component TaskbarPreview inherits TaskbarWindow {
    callback close-preview();
    callback toggle-test(bool);
    callback request-drag();
    in property <string> action-status;
    in property <bool> above-other-windows: true;
    in property <bool> test-active;
    in property <int> test-seconds;
    in property <string> test-status;
    in property <[DockApp]> live-apps;
    in property <string> clock-time;
    in property <string> clock-date;
    in property <string> clock-short-date;
    in property <CalendarMonth> clock-month;
    private property <bool> notifications-cleared;
    private property <TaskbarResult> project: {
        group-title: "Best match", title: "Microsoft Project", detail: "App",
        mark: "P", tint: #107a49,
    };
    private property <TaskbarResult> word: {
        group-title: "Open windows", title: "Project Plan – Word", detail: "Microsoft Word · 1 window",
        mark: "W", tint: #185abd,
    };
    private property <TaskbarResult> browser: {
        group-title: "Open windows", title: "Project research – Microsoft Edge", detail: "Microsoft Edge · Desktop 2",
        mark: "e", tint: #087f90,
    };
    private property <TaskbarResult> explorer: {
        title: "Work – File Explorer", detail: "File Explorer",
        mark: "F", tint: #926013,
    };
    private property <TaskbarResult> code: {
        title: "OmniSpot – Visual Studio Code", detail: "Visual Studio Code",
        mark: "</>", tint: #1773ac,
    };
    private property <TaskbarResult> slides: {
        group-title: "Files", title: "Project Kickoff.pptx", detail: "OneDrive – Work · Modified 2 h ago",
        mark: "P", tint: #ac3e28,
    };
    private property <TaskbarResult> sheet: {
        title: "Project Budget.xlsx", detail: "Work / Finance · Modified yesterday",
        mark: "X", tint: #146c43,
    };
    private property <TaskbarResult> settings: {
        group-title: "Settings", title: "OmniSpot Settings", detail: "Shortcuts and appearance",
        glyph: "\u{e713}",
    };
    private property <TaskbarResult> web: {
        title: root.query == "" ? "Search the web" : "Search the web for “" + root.query + "”",
        glyph: "\u{e721}",
    };

    query: "project";
    taskbar-test-active: root.test-active;
    taskbar-test-seconds: root.test-seconds;
    taskbar-test-status: root.test-status;
    toggle-taskbar-test(active) => { root.toggle-test(active); }
    time: root.clock-time;
    date: root.clock-date;
    short-date: root.clock-short-date;
    calendar-month: root.clock-month;
    battery-description: "87% · 5 h 12 min remaining";
    volume: 67;
    brightness: 72;
    desktops: ["Desktop 1", "Desktop 2"];
    window-count: "4";
    results: root.filter == 1 ? [
            root.project,
            { title: "Microsoft Edge", detail: "App", mark: "e", tint: #087f90 },
            { title: "File Explorer", detail: "App", mark: "F", tint: #926013 },
            { title: "Visual Studio Code", detail: "App", mark: "</>", tint: #1773ac },
        ]
        : root.filter == 2 ? (root.active-desktop == 0 ? [root.word, root.explorer] : [root.browser, root.code])
        : root.filter == 3 ? [root.slides, root.sheet]
        : root.filter == 4 ? [
            root.settings,
            { title: "Network & internet", detail: "Windows Settings", glyph: "\u{e701}" },
            { title: "Sound", detail: "Windows Settings", glyph: "\u{e767}" },
            { title: "Display", detail: "Windows Settings", glyph: "\u{e7f4}" },
        ]
        : root.filter == 5 ? [root.web]
        : root.query == "" ? [root.word, root.project, root.settings]
        : [root.project, root.word, root.slides, root.sheet, root.web];

    apps: root.live-apps;
    notifications: root.notifications-cleared ? [] : [
        { app: "Snipping Tool", message: "Screenshot copied to clipboard", time: "10:32 AM", mark: "S", tint: #2374a3 },
        { app: "Mail", message: "Project update from Daniel", time: "9:48 AM", mark: "M", tint: #0068aa },
        { app: "Teams", message: "Meeting in 10 minutes – Project Sync", time: "9:20 AM", mark: "T", tint: #5558a8 },
    ];
    clear-notifications => { root.notifications-cleared = true; }
    dismiss => { root.fullscreen = false; root.close-preview(); }
    drag-window => { root.request-drag(); }
    action-feedback: root.action-status;
    keep-above: root.above-other-windows;
}
