import { HorizontalBox, ScrollView, VerticalBox } from "std-widgets.slint";
import { Actions, OmniTheme, Symbol } from "../theme.slint";
import { SettingSwitch } from "../controls/setting-row.slint";
import { TabPillButton } from "controls.slint";
import { SearchResults, TaskbarResult } from "search-results.slint";
import { QuickSettings } from "quick-settings.slint";
import { NotificationList, TaskbarNotification } from "notifications.slint";
import { CalendarMonth } from "calendar.slint";
import { DockApp } from "app-dock.slint";
import { TaskbarStrip } from "taskbar-strip.slint";
import { WinXList } from "win-menu.slint";
import { TaskbarHeader } from "taskbar-header.slint";
import { TaskbarSidebar } from "taskbar-sidebar.slint";

export component TaskbarWindow inherits Window {
    in property <[TaskbarResult]> results;
    in property <[DockApp]> apps;
    in property <[TaskbarNotification]> notifications;
    in property <string> time;
    in property <string> date;
    in property <string> short-date;
    in property <CalendarMonth> calendar-month;
    in property <string> window-count;
    in property <string> battery-description;
    in property <float> volume;
    in property <float> brightness;
    in property <[string]> desktops;
    in property <string> action-feedback;
    in property <bool> keep-above: true;
    in property <bool> taskbar-test-active;
    in property <int> taskbar-test-seconds;
    in property <string> taskbar-test-status;
    in-out property <string> query;
    in-out property <int> filter;
    in-out property <int> active-desktop;
    in-out property <bool> fullscreen: false;
    in-out property <bool> quick-open: true;
    in-out property <bool> center-apps: true;
    private property <int> selected-index;
    private property <int> page;
    private property <string> preview-action;
    private property <string> footer-hint:
        root.action-feedback != "" ? root.action-feedback
        : strip.hovered-app != "" ? strip.hovered-app
        : sidebar.hovered-label != "" ? sidebar.hovered-label
        : header.hovered-label != "" ? header.hovered-label
        : root.preview-action != "" ? root.preview-action
        : root.page == 4 || root.page == 5 || root.page == 6 ? "" : "↑ ↓ Navigate     Enter Select";
    callback clear-notifications();
    callback dismiss();
    callback toggle-taskbar-test(bool);
    callback drag-window();

    title: "OmniSpot Taskbar";
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 960px;
    min-height: 600px;
    no-frame: true;
    always-on-top: root.keep-above;
    full-screen: root.fullscreen;
    background: transparent;
    default-font-family: "Segoe UI";
    forward-focus: search;
    init => { search.focus(); }
    changed results => { selected-index = 0; }

    function navigate(page: int) {
        root.page = page;
        root.filter = [0, 0, 2, 1, 0, 4, 0][page];
        root.preview-action = "";
        if page == 1 { search.focus(); }
    }

    function act(label: string) {
        if !Actions.run(label) { root.preview(label); }
    }

    function preview(label: string) {
        root.preview-action = label + " · Preview only";
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: root.fullscreen ? OmniTheme.glass-window-solid : OmniTheme.glass-window-bg;
        border-color: OmniTheme.glass-border;
        border-width: root.fullscreen ? 0px : 1px;
        border-radius: root.fullscreen ? 0px : 20px;
        clip: true;

        // glass sheen across the top and a soft inner highlight line
        Rectangle {
            width: parent.width;
            height: 220px;
            background: @linear-gradient(180deg, OmniTheme.glass-sheen-top 0%, OmniTheme.glass-sheen-bottom 100%);
        }
        Rectangle {
            x: 20px;
            width: parent.width - 40px;
            height: 1px;
            background: OmniTheme.glass-highlight;
        }

        FocusScope {
            width: parent.width;
            height: parent.height;
            key-pressed(event) => {
                if event.text == Key.UpArrow && root.page != 4 && root.page != 5 && root.results.length > 0 {
                    root.selected-index = max(0, root.selected-index - 1);
                    return accept;
                }
                if event.text == Key.DownArrow && root.page != 4 && root.page != 5 && root.results.length > 0 {
                    root.selected-index = min(root.results.length - 1, root.selected-index + 1);
                    return accept;
                }
                reject
            }

            VerticalBox {
                width: parent.width;
                height: parent.height;
                padding: 0px;
                spacing: 0px;

                header := TaskbarHeader {
                    page: root.page;
                    notification-count: root.notifications.length;
                    time: root.time;
                    short-date: root.short-date;
                    calendar-month: root.calendar-month;
                    quick-open <=> root.quick-open;
                    fullscreen <=> root.fullscreen;
                    navigate(page) => { root.navigate(page); }
                    action(target) => { root.act(target); }
                    drag-window => { root.drag-window(); }
                    dismiss => { root.dismiss(); }
                }

                Rectangle { height: 1px; background: OmniTheme.glass-border-subtle; }

                // Navigation, search and quick settings
                HorizontalBox {
                    vertical-stretch: 1;
                    padding: 0px;
                    spacing: 0px;


                    sidebar := TaskbarSidebar {
                        page: root.page;
                        navigate(page) => { root.navigate(page); }
                        action(target) => { root.act(target); }
                    }
                    Rectangle { width: 1px; background: OmniTheme.glass-border-subtle; }

                    VerticalBox {
                        padding: 16px;
                        horizontal-stretch: 1;
                        spacing: 10px;

                        Rectangle {
                            height: 42px;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: search.has-focus ? OmniTheme.accent : OmniTheme.glass-border-subtle;
                            background: OmniTheme.glass-card;

                            Symbol {
                                x: 14px;
                                width: 18px;
                                font-size: 15px;
                                text: "\u{e721}";
                                color: OmniTheme.text-secondary;
                            }

                            if root.query == "" : Text {
                                x: 42px;
                                width: parent.width - 80px;
                                text: "Search apps, windows, files, and the web";
                                color: OmniTheme.text-secondary;
                                font-size: 13px;
                                vertical-alignment: center;
                            }

                            search := TextInput {
                                x: 42px;
                                width: parent.width - 80px;
                                height: parent.height;
                                text: root.query;
                                color: OmniTheme.text-primary;
                                font-size: 13px;
                                vertical-alignment: center;
                                accessible-label: "Search apps, windows, files, and the web";
                                edited => {
                                    if root.page != 0 && root.page != 1 { root.navigate(1); }
                                    root.query = self.text;
                                    root.selected-index = 0;
                                }
                                accepted => {
                                    if root.page != 4 && root.page != 5 && root.selected-index < root.results.length {
                                        root.act(root.results[root.selected-index].title);
                                    }
                                }
                            }

                            if root.query != "" : Rectangle {
                                x: parent.width - 34px;
                                y: 7px;
                                width: 28px;
                                height: 28px;
                                border-radius: 14px;
                                background: clear-hit.has-hover ? OmniTheme.glass-pill-hover-bg : transparent;
                                Symbol { text: "\u{e711}"; font-size: 12px; color: OmniTheme.text-secondary; }
                                clear-hit := TouchArea {
                                    width: parent.width;
                                    height: parent.height;
                                    mouse-cursor: pointer;
                                    clicked => { root.query = ""; root.navigate(1); }
                                }
                            }
                        }

                        if root.page != 2 && root.page != 4 && root.page != 5 && root.page != 6 : HorizontalBox {
                            padding: 0px;
                            spacing: 6px;
                            alignment: start;
                            for tab[index] in ["All", "Apps", "Windows", "Files", "Settings", "Web"] : TabPillButton {
                                label: tab;
                                selected: index == root.filter;
                                activated => {
                                    root.filter = index;
                                    root.selected-index = 0;
                                    if root.page != 0 && root.page != 1 { root.navigate(1); }
                                }
                            }
                        }

                        if root.page == 2 : VerticalBox {
                            height: 76px;
                            padding: 0px;
                            spacing: 8px;
                            Text { text: "Task View"; color: OmniTheme.text-primary; font-size: 18px; font-weight: 600; }
                            HorizontalBox {
                                padding: 0px;
                                spacing: 8px;
                                alignment: start;
                                for desktop[index] in root.desktops : TabPillButton {
                                    label: desktop;
                                    selected: index == root.active-desktop;
                                    activated => { root.active-desktop = index; }
                                }
                            }
                            Rectangle { height: 1px; background: OmniTheme.glass-border-subtle; }
                        }

                        if root.page == 4 : ScrollView {
                            vertical-stretch: 1;
                            NotificationList {
                                notifications: root.notifications;
                                clear => { root.clear-notifications(); }
                            }
                        }

                        if root.page == 5 : ScrollView {
                            vertical-stretch: 1;
                            VerticalBox {
                                padding: 0px;
                                spacing: 8px;
                                Text { text: "Taskbar"; color: OmniTheme.text-primary; font-size: 18px; font-weight: 600; }
                                SettingSwitch {
                                    glyph: "\u{e7c4}";
                                    label: "Hide Windows taskbar completely";
                                    description: "Experimental. Restores automatically after " + root.taskbar-test-seconds + " seconds, or when you close this preview.";
                                    checked: root.taskbar-test-active;
                                    edited(active) => { root.toggle-taskbar-test(active); }
                                }
                                Text {
                                    text: root.taskbar-test-status;
                                    color: OmniTheme.text-secondary;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                SettingSwitch {
                                    glyph: "\u{e8a0}";
                                    label: "Center app icons";
                                    description: "Place pinned and running apps in the middle of the bar.";
                                    checked: root.center-apps;
                                    edited(value) => { root.center-apps = value; }
                                }
                            }
                        }

                        if root.page == 6 : ScrollView {
                            vertical-stretch: 1;
                            VerticalBox {
                                padding: 0px;
                                spacing: 8px;
                                Text { text: "Windows"; color: OmniTheme.text-primary; font-size: 18px; font-weight: 600; }
                                Text { text: "Power user tools and system settings."; color: OmniTheme.text-secondary; font-size: 12px; }
                                WinXList {
                                    chosen(target) => { root.act(target); }
                                }
                            }
                        }
                        if root.page != 4 && root.page != 5 && root.page != 6 : SearchResults {
                            rows: root.results;
                            show-filters: false;
                            selected-index <=> root.selected-index;
                            filter <=> root.filter;
                            vertical-stretch: 1;
                            result-selected(label) => { root.act(label); }
                        }

                        Text {
                            text: root.footer-hint;
                            color: OmniTheme.text-secondary;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }

                    if root.quick-open : Rectangle { width: 1px; background: OmniTheme.glass-border-subtle; }

                    if root.quick-open : VerticalBox {
                        width: 310px;
                        padding: 12px;
                        QuickSettings {
                            vertical-stretch: 1;
                            time: root.time;
                            date: root.date;
                            battery-description: root.battery-description;
                            volume: root.volume;
                            brightness: root.brightness;
                            notifications: root.notifications;
                            see-notifications => { root.navigate(4); }
                            open-settings => { root.navigate(5); }
                            media-previous => { root.act("media:prev"); }
                            media-next => { root.act("media:next"); }
                        }
                    }
                }

                strip := TaskbarStrip {
                    apps: root.apps;
                    center-apps: root.center-apps;
                    app-selected(name) => { root.act(name); }
                }
            }
        }
    }
}
