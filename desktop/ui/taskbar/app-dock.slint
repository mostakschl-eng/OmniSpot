import { HorizontalBox, ScrollView, VerticalBox } from "std-widgets.slint";
import { OmniTheme, PopupCard } from "../theme.slint";
import { AppMark, PanelButton } from "controls.slint";

export struct DockWindow {
    key: string,
    title: string,
}

export struct DockApp {
    id: string,
    icon: image,
    window-list: [DockWindow],
    name: string,
    mark: string,
    glyph: string,
    tint: color,
    windows: int,
    active: bool,
}

export component AppDock inherits HorizontalBox {
    in property <[DockApp]> apps;
    out property <string> hovered-app;
    callback app-selected(string);
    height: OmniTheme.strip-height;
    alignment: center;
    padding: 0px;
    spacing: OmniTheme.gap;

    for app in root.apps : item := Rectangle {
        width: 38px;
        height: OmniTheme.control-size;
        border-radius: OmniTheme.radius-m;
        border-width: keys.has-focus ? 1px : 0px;
        border-color: OmniTheme.accent;
        background: hit.pressed ? OmniTheme.press-bg
            : app.active ? OmniTheme.glass-pill-hover-bg
            : hit.has-hover ? OmniTheme.subtle : transparent;
        animate background { duration: 120ms; }
        accessible-role: button;
        accessible-label: app.name + (app.windows > 0 ? ", open windows: " + app.windows : ", pinned");
        accessible-action-default => { item.open(); }
        function open() {
            if app.window-list.length > 1 { picker.show(); }
            else { root.app-selected(app.id != "" ? app.id : app.name); }
        }

        if app.icon.width == 0 : AppMark {
            x: (parent.width - self.width) / 2;
            y: hit.pressed ? 10px : 8px;
            width: 22px;
            height: 22px;
            mark: app.mark;
            glyph: app.glyph;
            tint: app.tint;
            animate y { duration: 90ms; }
        }
        if app.icon.width > 0 : Image {
            x: (parent.width - self.width) / 2;
            y: hit.pressed ? 10px : 8px;
            width: 22px;
            height: 22px;
            source: app.icon;
            image-fit: contain;
        }

        picker := PopupWindow {
            x: 0px;
            y: -card.height - 8px;
            card := PopupCard {
                width: 250px;
                height: min(228px, app.window-list.length * 34px + 10px);
                ScrollView {
                    x: 5px; y: 5px; width: parent.width - 10px; height: parent.height - 10px;
                    VerticalBox {
                        padding: 0px; spacing: 0px;
                        for window in app.window-list : PanelButton {
                            label: window.title;
                            activated => { picker.close(); root.app-selected(window.key); }
                        }
                    }
                }
            }
        }

        // Running indicator: long accent pill when focused, short grey pill when idle.
        if app.windows > 0 : Rectangle {
            width: app.active ? 16px : 6px;
            height: 3px;
            x: (parent.width - self.width) / 2;
            y: parent.height - 6px;
            border-radius: 1.5px;
            background: app.active ? OmniTheme.accent : OmniTheme.indicator-idle;
            animate width { duration: 150ms; }
        }

        // Small count dot when an app has several windows.
        if app.windows > 1 : Rectangle {
            x: parent.width - 12px;
            y: 3px;
            width: 12px;
            height: 12px;
            border-radius: 6px;
            background: OmniTheme.glass-window-solid;
            border-width: 1px;
            border-color: OmniTheme.glass-border-subtle;
            Text {
                text: app.windows;
                color: OmniTheme.text-primary;
                font-size: 8px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        keys := FocusScope {
            width: parent.width;
            height: parent.height;
            key-pressed(event) => {
                if event.text == Key.Return || event.text == " " { item.open(); return accept; }
                reject
            }
        }
        hit := TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: pointer;
            changed has-hover => {
                if self.has-hover { root.hovered-app = app.name; }
                else if root.hovered-app == app.name { root.hovered-app = ""; }
            }
            clicked => { keys.focus(); item.open(); }
        }
    }

}
