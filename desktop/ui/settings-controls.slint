import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { OmniTheme, PopupCard, SettingsCard, Symbol } from "theme.slint";

export component NavigationItem inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> selected;
    callback activated();
    height: 36px;
    border-radius: 5px;
    background: selected || hit.has-hover || focus.has-focus ? OmniTheme.subtle : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.activated(); }
    if root.selected : Rectangle {
        x: 0px; y: 10px; width: 3px; height: 16px; border-radius: 1.5px; background: OmniTheme.accent;
    }
    HorizontalBox {
        padding-left: 12px; padding-right: 8px; spacing: 12px;
        Symbol { width: 20px; text: root.glyph; }
        Text { text: root.label; color: OmniTheme.text-primary; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
    }
    hit := TouchArea { clicked => { focus.focus(); root.activated(); } }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
            reject
        }
    }
}

export component SettingsDialog inherits Rectangle {
    in property <string> title;
    in property <string> message;
    in property <string> action;
    callback confirm();
    callback cancel();
    background: #00000066;
    TouchArea {}
    PopupCard {
        width: 430px;
        height: 170px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: OmniTheme.window-background;
        VerticalBox {
            padding: 22px; spacing: 8px;
            Text { text: root.title; font-size: 20px; font-weight: 600; color: OmniTheme.text-primary; }
            Text { text: root.message; font-size: 14px; color: OmniTheme.text-primary; wrap: word-wrap; vertical-stretch: 1; }
            HorizontalBox {
                padding: 0px; spacing: 8px; alignment: end;
                Button { text: root.action; height: 32px; clicked => { root.confirm(); } }
                Button { text: "Cancel"; primary: true; height: 32px; clicked => { root.cancel(); } }
            }
        }
    }
}

struct KeyboardKey { label: string, name: string, modifier: int, weight: float }

component KeyboardRow inherits HorizontalBox {
    in property <[KeyboardKey]> keys;
    in property <int> current-index;
    in property <bool> interactive;
    callback picked(int);
    padding: 0px; spacing: 4px;
    for key in keys : Rectangle {
        property <bool> enabled: root.interactive && key.modifier >= 0;
        property <bool> selected: key.modifier >= 0 && key.modifier == root.current-index;
        horizontal-stretch: key.weight;
        min-width: 22px;
        height: 44px;
        border-radius: 4px;
        border-width: 1px;
        border-color: selected ? OmniTheme.accent : OmniTheme.divider;
        background: selected ? OmniTheme.accent : enabled && (hit.has-hover || focus.has-focus) ? OmniTheme.accent.with-alpha(0.10) : OmniTheme.subtle;
        opacity: enabled ? 1 : 0.45;
        accessible-role: button;
        accessible-label: key.name == "" ? key.label : key.name;
        accessible-enabled: enabled;
        accessible-action-default => { if key.modifier >= 0 && root.interactive { root.picked(key.modifier); } }
        if key.modifier == 3 || key.modifier == 6 : Symbol {
            text: key.modifier == 3 ? "\u{e782}" : "\u{e8fd}";
            font-size: 15px; color: selected ? OmniTheme.accent-text : OmniTheme.text-primary;
        }
        if key.modifier != 3 && key.modifier != 6 : Text {
            x: 6px; width: parent.width - 12px;
            text: key.label;
            color: selected ? OmniTheme.accent-text : OmniTheme.text-primary;
            font-size: 12px;
            horizontal-alignment: (key.modifier == 4 || key.modifier == 5 || key.modifier == 7) || key.label == "Enter" ? right : key.modifier >= 0 ? left : center;
            vertical-alignment: key.modifier >= 0 || key.label == "Enter" ? bottom : center;
            height: parent.height - 5px;
        }
        hit := TouchArea { enabled: parent.enabled; clicked => { focus.focus(); root.picked(key.modifier); } }
        focus := FocusScope {
            enabled: parent.enabled;
            key-pressed(event) => {
                if event.text == Key.Return || event.text == " " { root.picked(key.modifier); return accept; }
                reject
            }
        }
    }
}

export component ModifierKeyboard inherits SettingsCard {
    in property <int> current-index;
    in property <bool> interactive: true;
    callback selected(int);
    VerticalBox {
        padding: 12px; spacing: 4px;
        KeyboardRow {
            current-index: root.current-index; interactive: root.interactive;
            picked(index) => { root.selected(index); }
            keys: [
                { label: "Caps Lock", name: "", modifier: 8, weight: 2.2 },
                { label: "A", name: "", modifier: -1, weight: 1 },
                { label: "S", name: "", modifier: -1, weight: 1 },
                { label: "D", name: "", modifier: -1, weight: 1 },
                { label: "F", name: "", modifier: -1, weight: 1 },
                { label: "G", name: "", modifier: -1, weight: 1 },
                { label: "H", name: "", modifier: -1, weight: 1 },
                { label: "J", name: "", modifier: -1, weight: 1 },
                { label: "K", name: "", modifier: -1, weight: 1 },
                { label: "L", name: "", modifier: -1, weight: 1 },
                { label: ";", name: "", modifier: -1, weight: 1 },
                { label: "'", name: "", modifier: -1, weight: 1 },
                { label: "Enter", name: "", modifier: -1, weight: 2.2 },
            ];
        }
        KeyboardRow {
            current-index: root.current-index; interactive: root.interactive;
            picked(index) => { root.selected(index); }
            keys: [
                { label: "Shift", name: "Left Shift", modifier: 2, weight: 2.5 },
                { label: "Z", name: "", modifier: -1, weight: 1 },
                { label: "X", name: "", modifier: -1, weight: 1 },
                { label: "C", name: "", modifier: -1, weight: 1 },
                { label: "V", name: "", modifier: -1, weight: 1 },
                { label: "B", name: "", modifier: -1, weight: 1 },
                { label: "N", name: "", modifier: -1, weight: 1 },
                { label: "M", name: "", modifier: -1, weight: 1 },
                { label: ",", name: "", modifier: -1, weight: 1 },
                { label: ".", name: "", modifier: -1, weight: 1 },
                { label: "/", name: "", modifier: -1, weight: 1 },
                { label: "Shift", name: "Right Shift", modifier: 7, weight: 2.8 },
            ];
        }
        KeyboardRow {
            current-index: root.current-index; interactive: root.interactive;
            picked(index) => { root.selected(index); }
            keys: [
                { label: "Ctrl", name: "Left Ctrl", modifier: 0, weight: 1 },
                { label: "Win", name: "Left Win", modifier: 3, weight: 1 },
                { label: "Alt", name: "Left Alt", modifier: 1, weight: 1 },
                { label: "", name: "Space", modifier: -1, weight: 8 },
                { label: "Alt", name: "Right Alt", modifier: 5, weight: 1 },
                { label: "Menu", name: "Apps / Menu", modifier: 6, weight: 0.8 },
                { label: "Ctrl", name: "Right Ctrl", modifier: 4, weight: 1 },
            ];
        }
    }
}
