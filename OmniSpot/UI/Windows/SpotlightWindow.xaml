<ui:FluentWindow x:Class="OmniSpot.UI.Windows.SpotlightWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:viewModels="clr-namespace:OmniSpot.UI.ViewModels"
                 mc:Ignorable="d"
                 WindowStyle="None"
                 ResizeMode="NoResize"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="#FF191D24"
                 Topmost="True"
                 ShowInTaskbar="False"
                 ShowActivated="True"
                 WindowStartupLocation="Manual"
                 SizeToContent="Manual"
                 Height="380"
                 Width="540"
                 x:ClassModifier="internal"
                 d:DataContext="{d:DesignInstance viewModels:SpotlightViewModel}">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <SolidColorBrush x:Key="SpotlightText" Color="#F4F7FB" />
        <Style x:Key="LauncherItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.22" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#364B5B70" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="SearchResultTemplate">
            <Grid Height="42" Margin="9,1" Cursor="Hand" ToolTip="{Binding Subtitle}"
                  MouseLeftButtonUp="OnItemClicked">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Icon}" Width="24" Height="24"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="8,0,8,0" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource SpotlightText}" />
                <TextBlock Grid.Column="2" Text="{Binding Type}" FontSize="10" Opacity="0.62"
                           VerticalAlignment="Center" Margin="8,0,6,0"
                           Foreground="{StaticResource SpotlightText}" />
            </Grid>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Border x:Name="CardBorder" CornerRadius="12" Background="#FF191D24" BorderThickness="1"
            BorderBrush="#405A6574">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="14,12,14,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="SearchBox"
                            Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Search apps and files"
                            Icon="{ui:SymbolIcon Search24}"
                            Height="44" FontSize="16"
                            Background="#FF242A33" Foreground="{StaticResource SpotlightText}"
                            ClearButtonEnabled="True"
                            VerticalContentAlignment="Center" />
                <Border Grid.Column="1" Margin="12,0,0,0" Padding="8,4"
                        VerticalAlignment="Center" CornerRadius="5"
                        BorderBrush="#45D8E4F2" BorderThickness="1">
                    <TextBlock Text="ESC" FontSize="10" Opacity="0.7"
                               Foreground="{StaticResource SpotlightText}" />
                </Border>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="#35D8E4F2" />

            <Grid Grid.Row="2" Margin="12,10,12,8">
                <StackPanel Visibility="{Binding ShowSuggestions, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="QUICK ACCESS" FontSize="10" FontWeight="SemiBold"
                               Margin="9,0,0,8" Opacity="0.7"
                               Foreground="{StaticResource SpotlightText}" />
                    <ListBox ItemsSource="{Binding Suggestions}"
                             SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                             ItemTemplate="{StaticResource SearchResultTemplate}"
                             ItemContainerStyle="{StaticResource LauncherItemStyle}"
                             Background="Transparent" BorderThickness="0"
                             MaxHeight="235"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </StackPanel>

                <StackPanel Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="SEARCH RESULTS" FontSize="10" FontWeight="SemiBold"
                               Margin="9,0,0,7" Opacity="0.7"
                               Foreground="{StaticResource SpotlightText}" />
                    <ListBox ItemsSource="{Binding Results}"
                             SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                             ItemTemplate="{StaticResource SearchResultTemplate}"
                             ItemContainerStyle="{StaticResource LauncherItemStyle}"
                             Background="Transparent" BorderThickness="0"
                             MaxHeight="235" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </StackPanel>

                <TextBlock Text="No matching apps or indexed files"
                           Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVis}}"
                           HorizontalAlignment="Center" Margin="0,22"
                           FontSize="13" Opacity="0.7"
                           Foreground="{StaticResource SpotlightText}" />
            </Grid>

            <Border Grid.Row="3" BorderBrush="#45D8E4F2"
                    BorderThickness="0,1,0,0" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SelectedPath}" FontSize="11" Opacity="0.72"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedPath}"
                               Foreground="{StaticResource SpotlightText}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="↑↓  Select     Enter  Open" Margin="18,0,0,0"
                               FontSize="11" Opacity="0.64"
                               Foreground="{StaticResource SpotlightText}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
