<Window x:Class="OmniSpot.UI.Windows.SpotlightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:viewModels="clr-namespace:OmniSpot.UI.ViewModels"
        xmlns:spotlight="clr-namespace:OmniSpot.Spotlight"
        mc:Ignorable="d"
        ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
        ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        WindowStartupLocation="Manual"
        SizeToContent="Height"
        Width="700"
        x:ClassModifier="internal"
        d:DataContext="{d:DesignInstance viewModels:SpotlightViewModel}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <!-- Shadow clearance -->
    <Border Padding="12,12,12,24">
        <!-- Floating glassy card container -->
        <Border x:Name="CardBorder"
                CornerRadius="16"
                Padding="18"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Opacity="0.97">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Search Input Bar -->
                <ui:TextBox Grid.Row="0"
                            x:Name="SearchBox"
                            Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Type to search apps and files..."
                            Icon="{ui:SymbolIcon Search24}"
                            Height="52"
                            FontSize="17"
                            ClearButtonEnabled="True"
                            VerticalContentAlignment="Center"
                            Margin="0,0,0,14" />

                <!-- Suggested Apps (Empty Query) -->
                <StackPanel Grid.Row="1"
                            Visibility="{Binding ShowSuggestions, Converter={StaticResource BoolToVis}}"
                            Margin="0,0,0,8">
                    <ListBox ItemsSource="{Binding Suggestions}"
                             SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type spotlight:SearchResult}">
                                <Border CornerRadius="8"
                                        Padding="10,8"
                                        Margin="3,2"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="OnItemClicked">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.1" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Height="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Image Grid.Column="0"
                                               Source="{Binding Icon}"
                                               Width="24"
                                               Height="24"
                                               Margin="0,0,12,0"
                                               RenderOptions.BitmapScalingMode="HighQuality" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   VerticalAlignment="Center"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Text="No matching apps or indexed files"
                           Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVis}}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,16"
                           FontSize="12"
                           Opacity="0.6"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                <!-- Search Results List -->
                <StackPanel Grid.Row="2"
                            Margin="0,0,0,8">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasResults}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <ScrollViewer MaxHeight="420"
                                  VerticalScrollBarVisibility="Auto"
                                  CanContentScroll="True">
                        <ListBox ItemsSource="{Binding Results}"
                                 SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type spotlight:SearchResult}">
                                    <Border CornerRadius="8"
                                            Padding="10,8"
                                            Margin="0,2"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="OnItemClicked">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.1" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid Height="42">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Image Grid.Column="0"
                                                   Source="{Binding Icon}"
                                                   Width="26"
                                                   Height="26"
                                                   Margin="0,0,12,0"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding Subtitle}"
                                                           FontSize="12"
                                                           Opacity="0.6"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </StackPanel>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </StackPanel>

                <!-- Footer keyboard hints -->
                <DockPanel Grid.Row="3" Margin="4,4,4,0">
                    <TextBlock Text="↑ ↓  Select     Enter  Open     Esc  Close"
                               FontSize="11"
                               Opacity="0.5"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </DockPanel>
            </Grid>
        </Border>
    </Border>
</Window>
