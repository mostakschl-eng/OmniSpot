<Window x:Class="OmniSpot.UI.Windows.SpotlightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:viewModels="clr-namespace:OmniSpot.UI.ViewModels"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        WindowStartupLocation="Manual"
        SizeToContent="Height"
        Width="660"
        x:ClassModifier="internal"
        d:DataContext="{d:DesignInstance viewModels:SpotlightViewModel}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ResultTemplate">
            <Border Padding="12,9" CornerRadius="8" Cursor="Hand" MouseLeftButtonUp="OnItemClicked">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="8"
                            Background="{DynamicResource CardHoverBackgroundBrush}"
                            VerticalAlignment="Center">
                        <Image Source="{Binding Icon}" Width="22" Height="22"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.65"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border Padding="12,12,12,24">
        <Border x:Name="CardBorder" CornerRadius="14" Padding="0"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="18,14,18,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="SearchBox"
                                Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Search apps and files"
                                Icon="{ui:SymbolIcon Search24}"
                                Height="48" FontSize="17"
                                ClearButtonEnabled="True"
                                VerticalContentAlignment="Center" />
                    <Border Grid.Column="1" Margin="12,0,0,0" Padding="8,3"
                            VerticalAlignment="Center" CornerRadius="5"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <TextBlock Text="ESC" FontSize="10" Opacity="0.65"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Border>
                </Grid>

                <Border Grid.Row="1" Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" />

                <Grid Grid.Row="2" Margin="12,10,12,12">
                    <StackPanel Visibility="{Binding ShowSuggestions, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="QUICK ACCESS" FontSize="10" FontWeight="SemiBold"
                                   Margin="12,0,0,7" Opacity="0.65"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <ListBox ItemsSource="{Binding Suggestions}"
                                 SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource ResultTemplate}"
                                 ItemContainerStyle="{StaticResource ResultItemStyle}"
                                 Background="Transparent" BorderThickness="0"
                                 MaxHeight="390" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="RESULTS" FontSize="10" FontWeight="SemiBold"
                                   Margin="12,0,0,7" Opacity="0.65"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <ListBox ItemsSource="{Binding Results}"
                                 SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource ResultTemplate}"
                                 ItemContainerStyle="{StaticResource ResultItemStyle}"
                                 Background="Transparent" BorderThickness="0"
                                 MaxHeight="430" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </StackPanel>

                    <TextBlock Text="No matching apps or indexed files"
                               Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVis}}"
                               HorizontalAlignment="Center" Margin="0,20"
                               FontSize="13" Opacity="0.65"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Grid>

                <Border Grid.Row="3" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0" Padding="22,10">
                    <TextBlock Text="↑ ↓  Navigate     Enter  Open     Esc  Close"
                               FontSize="11" Opacity="0.6"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>