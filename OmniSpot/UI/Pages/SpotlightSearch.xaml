<Page x:Class="OmniSpot.UI.Pages.SpotlightSearch"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:OmniSpot.UI.Controls"
      xmlns:designTime="clr-namespace:OmniSpot.UI.ViewModels.DesignTime"
      mc:Ignorable="d"
      Title="Spotlight Search"
      ScrollViewer.CanContentScroll="False"
      d:DataContext="{d:DesignInstance designTime:SettingsStateDesignTime, IsDesignTimeCreatable=True}"
      d:DesignWidth="700"
      MinWidth="200"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}" x:ClassModifier="internal">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
        <StackPanel Margin="0,5,0,20">

            <ui:TextBlock Text="Spotlight Search"
                          FontTypography="BodyStrong"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                          Margin="2,0,0,7" />

            <ui:CardControl Margin="0,8,0,12"
                            Padding="20,10,20,10"
                            Icon="{ui:SymbolIcon Search24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                      Text="Enable Spotlight Search"
                                      TextWrapping="WrapWithOverflow" />
                        <ui:TextBlock Appearance="Secondary"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="Quick search launcher for applications and Windows Search indexed files."
                                      TextWrapping="WrapWithOverflow" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:CardControl.Content>
                    <ui:ToggleSwitch IsChecked="{Binding SpotlightEnabled, Mode=TwoWay}"
                                     HorizontalContentAlignment="Left"
                                     OffContent="Off"
                                     OnContent="On" />
                </ui:CardControl.Content>
            </ui:CardControl>

            <!-- Modifier Key -->
            <DockPanel Margin="2,0,0,8">
                <ui:TextBlock Text="Activation Shortcut (Modifier + Space bar)"
                              FontTypography="BodyStrong"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                              VerticalAlignment="Center" />
            </DockPanel>

            <ui:Card Margin="0,0,0,14" Padding="12,12,12,12" IsEnabled="{Binding SpotlightEnabled}">
                <controls:ModifierKeySelector SelectedModifier="{Binding SpotlightModifierKey, Mode=TwoWay}" />
            </ui:Card>

            <!-- Standard Index Folders -->
            <DockPanel Margin="2,6,0,8">
                <ui:TextBlock Text="Standard Indexed Locations"
                              FontTypography="BodyStrong"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                              VerticalAlignment="Center" />
            </DockPanel>

            <ui:CardControl Margin="0,0,0,14" Padding="20,12,20,12" Icon="{ui:SymbolIcon Folder24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                      Text="Automatic Library &amp; System Indexing"
                                      TextWrapping="WrapWithOverflow" />
                        <ui:TextBlock Appearance="Secondary"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="Applications, Desktop, Documents, Downloads, Videos, Music, Pictures"
                                      TextWrapping="WrapWithOverflow" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:CardControl.Content>
                    <Border CornerRadius="8"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="8,4,8,4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Checkmark12"
                                           Foreground="{DynamicResource SystemAccentColorBrush}"
                                           Margin="0,0,4,0"
                                           VerticalAlignment="Center" />
                            <ui:TextBlock FontSize="11"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Text="Active" />
                        </StackPanel>
                    </Border>
                </ui:CardControl.Content>
            </ui:CardControl>

            <!-- Custom Indexed Folders -->
            <DockPanel Margin="2,6,0,8">
                <ui:TextBlock Text="Custom Search Folders"
                              FontTypography="BodyStrong"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                              VerticalAlignment="Center" />
            </DockPanel>

            <ui:CardControl Margin="0,0,0,10" Padding="20,12,20,12" Icon="{ui:SymbolIcon FolderAdd24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                      Text="Add Custom Folders"
                                      TextWrapping="WrapWithOverflow" />
                        <ui:TextBlock Appearance="Secondary"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="Index additional folders to include them in search."
                                      TextWrapping="WrapWithOverflow" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:CardControl.Content>
                    <ui:Button Content="Add Folder..."
                               Icon="{ui:SymbolIcon FolderAdd20}"
                               Appearance="Secondary"
                               Command="{Binding AddCustomFolderCommand}" />
                </ui:CardControl.Content>
            </ui:CardControl>

            <!-- Custom Folders List -->
            <ItemsControl ItemsSource="{Binding SpotlightCustomDirectories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,6" Padding="14,10,14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Folder20"
                                               Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center" />
                                <ui:TextBlock Grid.Column="1"
                                              Text="{Binding}"
                                              VerticalAlignment="Center"
                                              TextTrimming="CharacterEllipsis" />
                                <ui:Button Grid.Column="2"
                                           Icon="{ui:SymbolIcon Delete20}"
                                           Appearance="Transparent"
                                           Padding="6,4"
                                           Command="{Binding DataContext.RemoveCustomFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}"
                                           ToolTipService.ToolTip="Remove from search index" />
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>

